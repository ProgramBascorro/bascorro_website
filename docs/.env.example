# R2 gallery listing (server-side only)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=bascorro-landing-page
R2_PUBLIC_BASE_URL=https://<public-domain-or-r2-dev>/<bucket-or-custom-prefix>
R2_GALLERY_PREFIX=images/gallery/
